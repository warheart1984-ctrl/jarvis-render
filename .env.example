# Jarvis Configuration
# Copy this to .env and fill in your values.

# Spiral Intelligence backend (V1/V7/V8 FastAPI)
JARVIS_SPIRAL_API_BASE=http://127.0.0.1:8000
JARVIS_SERVICE_TOKEN=
JARVIS_ENVIRONMENT=development
JARVIS_CONTINUITY_LEDGER_URL=
JARVIS_CONTINUITY_LEDGER_TOKEN=
JARVIS_SPIRAL_WS_BASE=ws://127.0.0.1:8000
JARVIS_INFINITY_API_BASE=
JARVIS_INFINITY_ENABLED=false

# Spiral Private API (Node.js HMAC server)
JARVIS_SPIRAL_PRIVATE_API_BASE=http://127.0.0.1:8787
JARVIS_SPIRAL_API_KEY_ID=
JARVIS_SPIRAL_API_KEY_SECRET=

# LLM provider (mock = rule-based responses, no external API needed)
JARVIS_LLM_PROVIDER=mock
JARVIS_LLM_API_KEY=
JARVIS_LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_API_KEY=
JARVIS_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
JARVIS_LLM_MAX_TOKENS=768
JARVIS_LLM_FALLBACK_MODELS=openai/gpt-oss-20b,z-ai/glm-5.3-flash
JARVIS_LLM_ATTEMPT_TIMEOUT_SECONDS=15
JARVIS_LLM_TIMEOUT_SECONDS=45
JARVIS_LLM_TEMPERATURE=0.7

# Server
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8100
# Comma-separated CORS origins. Use "*" for local dev only.
# Example for production: JARVIS_CORS_ORIGINS=https://app.example.com,https://admin.example.com
JARVIS_CORS_ORIGINS=*
