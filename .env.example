# Jarvis Configuration
# Copy this to .env and fill in your values.

# Spiral Intelligence backend (V1/V7/V8 FastAPI)
JARVIS_SPIRAL_API_BASE=http://127.0.0.1:8000
JARVIS_SPIRAL_WS_BASE=ws://127.0.0.1:8000

# Spiral Private API (Node.js HMAC server)
JARVIS_SPIRAL_PRIVATE_API_BASE=http://127.0.0.1:8787
JARVIS_SPIRAL_API_KEY_ID=
JARVIS_SPIRAL_API_KEY_SECRET=

# LLM provider (mock = rule-based responses, no external API needed)
JARVIS_LLM_PROVIDER=mock
JARVIS_LLM_API_KEY=
JARVIS_LLM_MODEL=gpt-4
JARVIS_LLM_TEMPERATURE=0.7

# Server
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8100
